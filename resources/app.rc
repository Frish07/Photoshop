#include <winuser.h>
101 RCDATA "coastal-road.jpg"
102 ICON "pixelforge.ico"
1 RT_MANIFEST "pixelforge.manifest"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "PixelForge Raster Editor"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "PixelForge"
            VALUE "OriginalFilename", "PixelForge.exe"
            VALUE "ProductName", "PixelForge"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
